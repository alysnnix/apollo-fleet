# Apollo Fleet config
#
# Each [[seat]] = one Apollo template. Apollo Fleet starts the FIRST seat
# eagerly and spawns the NEXT seat only when all currently-spawned seats have
# an active client. So your fleet always has exactly one idle seat ready for
# the next device to connect, and never spawns more than needed.
#
# The real limit on simultaneous active streams comes from your GPU's video
# encoder, not Apollo. Typical caps:
#   - NVIDIA GeForce (consumer):  3 concurrent NVENC sessions on older drivers;
#                                 up to 8 on recent ones (R555+).
#   - NVIDIA RTX Pro / Quadro:    no hard limit (use as many as VRAM allows).
#   - AMD (AMF) / Intel (QSV):    typically 2-4 concurrent sessions.
# Define as many seats as you have encoder slots. Idle seats don't consume
# encoder sessions — only seats with a connected Moonlight client do.
#
# Audio sinks: each seat captures audio from a distinct virtual sink so
# clients don't share audio. If the configured sink doesn't exist on this
# host, Apollo falls back to the system default (a warning is logged and the
# fleet still starts). Install:
#   - Voicemeeter Potato (free, gives 3 sinks): https://vb-audio.com/Voicemeeter/potato.htm
#   - VB-Cable (free, gives 1 sink):            https://vb-audio.com/Cable/
#
# Steam Streaming Speakers is bundled with Apollo and is normally present.
#
# gamepad_only = true blocks keyboard/mouse from the streamed client so it
# can't steal focus from the host's physical keyboard/mouse.
#
# primary = true makes that seat's streamed display the Windows primary monitor
# when a client connects (dd_configuration_option = ensure_primary). Leave it off
# on the other seats so they come up as secondary displays. Set it on at most one
# seat.

apollo_path = 'C:\Program Files\Apollo\sunshine.exe'

# state_dir: where per-seat state is stored. Leave this commented out to use
# %USERPROFILE%\.apollo-fleet for whoever runs Apollo Fleet. Only set it if you
# want a custom location; never hardcode another machine's user folder.
# state_dir = 'D:\apollo-fleet-state'

[[seat]]
name         = "desk-1"
port         = 47989
audio_sink   = "Steam Streaming Speakers"
gamepad_only = true
primary      = true

[[seat]]
name         = "desk-2"
port         = 48029
audio_sink   = "Voicemeeter Input"
gamepad_only = true

[[seat]]
name         = "desk-3"
port         = 48069
audio_sink   = "Voicemeeter AUX Input"
gamepad_only = true

[[seat]]
name         = "desk-4"
port         = 48109
audio_sink   = "Voicemeeter VAIO3 Input"
gamepad_only = true
